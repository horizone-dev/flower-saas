# --- Determinism / reproducibility ---
# Refuse to run if the active package manager != the pinned `packageManager` field.
package-manager-strict=true
package-manager-strict-version=true
# Honour the "engines" field for node/pnpm.
engine-strict=true
# Pin exact versions on `pnpm add` — no caret ranges creeping in.
save-exact=true
# Deterministic peer resolution.
auto-install-peers=true
dedupe-peer-dependents=true
resolution-mode=highest
# Fail loudly on lockfile drift in CI (overridden locally by --no-frozen-lockfile).
# CI passes --frozen-lockfile explicitly.

# --- Hoisting / isolation ---
# Default pnpm isolation (no hoist to root) keeps module boundaries honest.
# A minimal allow-list only where tooling genuinely needs root visibility.
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@types/node

# --- Misc ---
strict-peer-dependencies=false
