# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
next-env.d.ts
.turbo/
*.tsbuildinfo

# Next.js 16 regenerates these per-app on `next dev` — machine-local agent hints,
# not project rules (the authoritative rules file is the repo-root CLAUDE.md).
apps/*/AGENTS.md
apps/*/CLAUDE.md

# Test / coverage
coverage/
*.lcov
.vitest/
test-results/
playwright-report/
apps/super-admin-web/e2e/.smoke-auth.json

# Env & secrets — NEVER commit real values
.env
.env.*
!.env.example

# Prisma generated client (regenerated on install / `prisma generate`)
**/generated/client/
**/node_modules/.prisma/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Docker / local data volumes
infra/docker/data/
*.pid

# generated scan artifacts
sbom*.json
trivy-results*
