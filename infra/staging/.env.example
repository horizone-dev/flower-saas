# Flower SaaS — staging environment. COPY to infra/staging/.env.staging (git-ignored), fill EVERY value, chmod 600.
# NEVER commit real values. `node infra/staging/preflight.mjs` refuses placeholders, short secrets and reused passwords.
# Generate a strong secret:   openssl rand -hex 32        (or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ── Public hostnames (DNS A records -> this host; ports 80/443 open). Use real names, not localhost. ──
# The till (POS PWA). Its /v1/* is proxied to the API (single origin: no CORS, first-party cookies). The platform realm is blocked here.
POS_HOST=CHANGE_ME.pos.example.com
# Owner Web.
OWNER_HOST=CHANGE_ME.owner.example.com
# Operator host: serves ONLY /v1/platform/* and ONLY to ADMIN_CIDR (platform operators provision tenants here).
OPS_HOST=CHANGE_ME.ops.example.com
# Operator network allowed to reach OPS_HOST (CIDR, e.g. your office/VPN egress: 203.0.113.0/24). Never 0.0.0.0/0.
ADMIN_CIDR=CHANGE_ME

# Host ports for the proxy (leave at 80/443 on a real host; the local smoke uses 8080/8443).
HTTP_PORT=80
HTTPS_PORT=443
# Caddyfile for TLS: ./Caddyfile (automatic ACME certificates). ./Caddyfile.local is for the local smoke only.
CADDYFILE=./Caddyfile

# ── Images (build from a CLEAN committed tree; see docs/mvp/RELEASE-RUNBOOKS.md) ──
API_IMAGE=flower/api:CHANGE_ME
# POS must be built with: --build-arg API_PROXY_TARGET=http://api:3001 --build-arg NEXT_PUBLIC_API_BASE_URL=
POS_IMAGE=flower/pos-pwa:CHANGE_ME
OWNER_IMAGE=flower/owner-web:CHANGE_ME
MIGRATE_IMAGE=flower/migrate:CHANGE_ME

# ── Migration safety ──
# `check` = read-only report of pending approved migrations (the default for a first look). `deploy` = apply approved migrations.
# Set per command:  MIGRATION_MODE=deploy docker compose … up -d     (the compose file refuses to run without it)
MIGRATION_MODE=check

# ── Secrets (all distinct, all random, >= 24 characters; the API refuses the dev defaults in production) ──
# PostgreSQL superuser — used ONLY by the backup and migration jobs, never by the API.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
POSTGRES_DB=flower
# Application login roles (set by the roles job after the migrations): flower_app (RLS enforced) and flower_platform (audited cross-tenant).
APP_DB_PASSWORD=CHANGE_ME
PLATFORM_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Object storage root credentials (readiness probe + future documents).
MINIO_ROOT_USER=flower_minio_CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
# Signs access tokens. Rotating it logs everyone out.
AUTH_JWT_SECRET=CHANGE_ME

# ── Secrets vault (REQUIRED CHOICE) ──
# Production refuses `dev`; `kms` has no provider wired yet. `disabled` (fail-closed: the vault can never hold or reveal a secret) exists ONLY in
# the unapproved patch R-1 (docs/decisions/proposed-migrations/patches/R1-secrets-disabled-provider.patch). Until R-1 (or a KMS provider) is
# approved and built into the API image, the API cannot start in production mode.
SECRETS_PROVIDER=disabled
