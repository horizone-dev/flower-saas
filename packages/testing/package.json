{
  "name": "@flower/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Testcontainers bootstrap (Postgres + Redis + MinIO), withTenantContext, the tenant + branch isolation probe harness, and concurrency-test utilities (ARCHITECTURE §54).",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@testcontainers/minio": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "testcontainers": "12.1.0"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
