# syntax=docker/dockerfile:1
#
# Builds MinIO Server from pinned upstream source for the test harness
# (packages/testing/src/containers.ts). Depends on NEITHER `docker.io/minio/minio`
# NOR `quay.io/minio/minio` — both returned 401 Unauthorized (repository-wide,
# every tag including `latest`) when this fix was written; MinIO's Community
# Edition moved to a source-only distribution model. This build clones and
# compiles the exact pinned release directly from GitHub instead.
#
# Pinned release: RELEASE.2025-04-08T15-41-24Z
# Upstream commit (GPG-signed annotated tag, verified via the GitHub tag API
# for minio/minio@RELEASE.2025-04-08T15-41-24Z):
#   d0cada583fce88f60cb276ddfb06f5cb16820069
# go.mod at that commit pins: go 1.23.0 / toolchain go1.23.6.

FROM golang:1.23.6-bookworm AS builder

WORKDIR /src

# Shallow-clone the exact tag, then fail closed if it does not resolve to the
# expected commit (protects against a force-pushed/retagged upstream ref).
RUN git clone --depth 1 --branch RELEASE.2025-04-08T15-41-24Z \
      https://github.com/minio/minio.git . \
    && test "$(git rev-parse HEAD)" = "d0cada583fce88f60cb276ddfb06f5cb16820069"

RUN go mod download

# Mirrors the upstream Makefile's own `build:` target (`go build -tags kqueue
# -trimpath --ldflags "$(LDFLAGS)" -o ./minio`, with LDFLAGS generated by
# `go run buildscripts/gen-ldflags.go` — called with NO argument, exactly as
# the plain `make build` a MinIO contributor runs locally does; `gen-ldflags.go`
# only accepts a raw timestamp (it calls `time.Parse` on it directly), never a
# full "RELEASE.…" tag string, so it must be left to default to the commit
# time itself. This embeds "DEVELOPMENT.<commit-timestamp>" as the version
# string rather than "RELEASE.2025-04-08T15-41-24Z" — cosmetic only; the
# server binary compiled is byte-for-byte the same pinned source. Skips only
# the Makefile's `checks`/`build-debugging` prerequisites (host sanity checks
# and unrelated debug-helper binaries under docs/debugging/ — neither affects
# the produced `minio` server binary).
RUN CGO_ENABLED=0 go build -tags kqueue -trimpath \
      -ldflags "$(go run buildscripts/gen-ldflags.go)" \
      -o /out/minio .

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/minio /usr/bin/minio

# MinioContainer (@testcontainers/minio) supplies the full command
# (`server --console-address :9001 /data`) and env (MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD) at container-start time; no wrapper script is needed —
# the minio binary itself reads those directly.
ENTRYPOINT ["minio"]
