{
  "name": "@flower/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint flat config + boundary rules + custom lint rules, tsconfig bases, Tailwind preset, Prettier config.",
  "license": "UNLICENSED",
  "exports": {
    "./eslint": "./src/eslint/index.js",
    "./eslint/plugin": "./src/eslint/plugin.js",
    "./prettier": "./src/prettier/index.js",
    "./tailwind": "./src/tailwind/preset.js",
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/node": "./tsconfig/node.json",
    "./tsconfig/nest": "./tsconfig/nest.json",
    "./tsconfig/next": "./tsconfig/next.json",
    "./tsconfig/react-lib": "./tsconfig/react-lib.json"
  },
  "scripts": {
    "build": "echo \"@flower/config: no build step (config-only package)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run && node ./scripts/assert-boundary-fixture-fails.mjs",
    "test:negative": "node ./scripts/assert-boundary-fixture-fails.mjs",
    "clean": "rimraf node_modules .turbo"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.69.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/rule-tester": "8.69.0",
    "@typescript-eslint/utils": "8.69.0",
    "eslint": "10.9.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "prettier": ">=3",
    "tailwindcss": ">=4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  }
}
