{
  "name": "@flower/service-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared bootstrap plumbing for the non-API runtime roles (worker / scheduler / realtime): env parsing, pino logger, a Redis connection helper, a tiny health HTTP server, graceful shutdown. NO domain/business logic (CLAUDE.md rule 1). Added Phase 0 Task 0.7 — see ADR-0013.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "zod": "^4"
  }
}
