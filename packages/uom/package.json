{
  "name": "@flower/uom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unit-of-measure families, fractional-safe quantities (NUMERIC(18,4)), and conversion math. Pure — no I/O, no non-determinism.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rimraf dist node_modules .turbo"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "eslint": "10.9.1",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
