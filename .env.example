# ---------------------------------------------------------------------------
# Flower SaaS — local development environment (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- PostgreSQL 17 (docker compose: service "postgres") ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flower
POSTGRES_PASSWORD=flower_local_dev
POSTGRES_DB=flower
# App connection (direct). Prisma migrate uses this. Scoped queries drop to
# `flower_app` via SET LOCAL ROLE (ADR-0014), so a superuser URL is fine in dev.
DATABASE_URL=postgresql://flower:flower_local_dev@localhost:5432/flower?schema=public
# The separate audited platform path (flower_platform, BYPASSRLS). Same URL in dev.
PLATFORM_DATABASE_URL=postgresql://flower:flower_local_dev@localhost:5432/flower?schema=public
# Pooled connection via PgBouncer (spike / 0.6 only).
DATABASE_URL_POOLED=postgresql://flower:flower_local_dev@localhost:6432/flower?schema=public&pgbouncer=true

# --- Redis 7 (docker compose: service "redis") ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth (task 1.4/1.5). DEV values — production supplies real secrets. ---
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-000
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_STEP_UP_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=43200

# --- Object storage — MinIO (docker compose: service "minio") ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=flower_minio
S3_SECRET_ACCESS_KEY=flower_minio_local_dev
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PRIVATE=flower-private
S3_BUCKET_QUARANTINE=flower-quarantine
S3_BUCKET_PUBLIC=flower-public

# --- ClamAV (docker compose: service "clamav") ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Mailpit dev SMTP (docker compose: service "mailpit") ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@flower.local

# --- Application process ports ---
API_PORT=3001
REALTIME_PORT=3002
WORKER_METRICS_PORT=3011
SCHEDULER_METRICS_PORT=3012
SUPER_ADMIN_WEB_PORT=3100
OWNER_WEB_PORT=3200
POS_PWA_PORT=3300
CUSTOMER_WEB_PORT=3400

# --- Frontend → API base URL ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Observability ---
LOG_LEVEL=debug
