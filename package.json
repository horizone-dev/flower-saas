{
  "name": "flower-saas",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant florist commerce SaaS for the GCC — modular monolith, TypeScript monorepo.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml}\"",
    "dev:up": "bash tooling/scripts/dev-up.sh",
    "dev:down": "docker compose down",
    "wait-healthy": "bash tooling/scripts/wait-healthy.sh",
    "db:reset": "bash tooling/scripts/db-reset.sh",
    "seed": "bash tooling/scripts/seed.sh",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "esbuild",
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "mysql2@<3.23.1": ">=3.23.1",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "sharp@<0.35.5": ">=0.35.5",
      "source-map-js@<1.2.2": ">=1.2.2",
      "fastify@<5.12.6": "5.12.6",
      "undici@<8.12.2": "8.12.2",
      "vite@<8.2.4": "8.2.4",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "fast-uri@>=4.0.0 <4.2.3": "4.2.3",
      "glob@<14.0.2": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    },
    "supportedArchitectures": {
      "os": [
        "win32",
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
