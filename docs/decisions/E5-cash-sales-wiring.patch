@@ -0,0 +1,63 @@
+import { Inject, Injectable } from '@nestjs/common';
+import type { ScopedTx } from '@flower/db';
+import { requireTenantContext } from '../../common/context/index.js';
+import { DomainError } from '../../common/errors/domain-error.js';
+import {
+  CashMovementRecorderRepository,
+  type CashSourceRef,
+  type RecordOutcome,
+} from './cash-movement-recorder.repository.js';
+
+/**
+ * E-5 — the ONE entry point the frozen sale / payment / receipt / refund transactions call (inside their own transaction) once the
+ * owner approves the wiring. It builds the caller identity from the verified `RequestContext` (never a request field), runs the
+ * recorder, and applies the OWNER'S policy to a refusal.
+ *
+ *  OFF         — does nothing at all (the shipped default: the patch changes no behaviour until the owner flips it).
+ *  POS_STRICT  — a session WITHOUT a verified registered device (Owner Web, legacy attribution-only terminal) is skipped; a verified POS
+ *                terminal must have an open register session, a verified device and the right scope, or the WHOLE transaction aborts.
+ *  ALL_STRICT  — as POS_STRICT, and a cash tender from a session without a verified terminal is refused too.
+ *
+ * A non-cash tender / refund is never a refusal under any policy (the recorder says NOT_ELIGIBLE before touching the register).
+ */
+export type CashSalesPolicy = 'OFF' | 'POS_STRICT' | 'ALL_STRICT';
+export const CASH_SALES_POLICY = Symbol('CASH_SALES_POLICY');
+
+const ACCEPTED: ReadonlySet<RecordOutcome['kind']> = new Set([
+  'RECORDED',
+  'ALREADY_RECORDED',
+  'NOT_ELIGIBLE',
+]);
+
+@Injectable()
+export class CashSourceWiringRepository {
+  constructor(
+    private readonly recorder: CashMovementRecorderRepository,
+    @Inject(CASH_SALES_POLICY) private readonly policy: CashSalesPolicy,
+  ) {}
+
+  async recordInTx(tx: ScopedTx, refs: readonly CashSourceRef[]): Promise<void> {
+    if (this.policy === 'OFF' || refs.length === 0) return;
+    const ctx = requireTenantContext();
+    const outcomes = await this.recorder.recordManyInTx(
+      tx,
+      {
+        tenantId: ctx.tenantId,
+        terminalId: ctx.posTerminalId,
+        deviceId: ctx.deviceId,
+        actorUserId: ctx.userId,
+      },
+      refs,
+    );
+    for (const o of outcomes) {
+      if (ACCEPTED.has(o.kind)) continue;
+      if (o.kind === 'NO_VERIFIED_TERMINAL' && this.policy === 'POS_STRICT') continue;
+      // the refusal aborts the caller's transaction: the sale / payment / refund and its drawer movement commit together or not at all
+      throw new DomainError(
+        'CASH_REGISTER_REFUSED',
+        `the cash register refused this cash movement: ${o.kind}`,
+        409,
+      );
+    }
+  }
+}
