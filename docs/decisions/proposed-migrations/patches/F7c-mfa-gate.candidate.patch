diff --git a/apps/api/src/modules/access/mfa-enrolment-gate.ts b/apps/api/src/modules/access/mfa-enrolment-gate.ts
new file mode 100644
index 0000000..f7ff5c1
--- /dev/null
+++ b/apps/api/src/modules/access/mfa-enrolment-gate.ts
@@ -0,0 +1,39 @@
+/**
+ * F-7c safeguard (CANDIDATE, unapplied) — a holder of a mandatory-MFA system role who has no CONFIRMED TOTP factor gets an
+ * ENROLMENT-ONLY session: every permission except {@link ENROLMENT_ONLY_PERMISSIONS} is withheld until the factor is confirmed.
+ *
+ * Why: `payments:collect`, `receivables:advance:apply` and the customer operations are routine (not step-up) keys, so a freshly
+ * invited manager could otherwise move money on a password alone. Step-up cannot help before enrolment (it needs a factor).
+ *
+ * Fail-closed by construction: the decision is derived from the database on EVERY access resolution (login, token refresh, and the
+ * refresh that follows an RBAC change), so no path can hand an un-enrolled manager a full permission set; if the factor lookup
+ * throws, the resolution throws and no session is issued.
+ */
+
+/** System role keys that must hold a CONFIRMED TOTP factor before any of their permissions work. Cashier/sales are NOT in this list. */
+export const MFA_MANDATORY_SYSTEM_ROLE_KEYS: readonly string[] = Object.freeze(['manager']);
+
+/**
+ * The only key an enrolment-only session keeps. It guards exactly the routes an un-enrolled user needs
+ * (`POST /auth/mfa/enrol`, `/auth/mfa/confirm`, `/auth/step-up`, `/auth/logout`) and nothing financial.
+ */
+export const ENROLMENT_ONLY_PERMISSIONS: readonly string[] = Object.freeze(['users:view']);
+
+export interface HeldRole {
+  readonly key: string;
+  readonly isSystem: boolean;
+}
+
+/** True when the user holds an active mandatory-MFA SYSTEM role and has no confirmed TOTP factor. */
+export function mfaEnrolmentRequired(input: {
+  readonly roles: readonly HeldRole[];
+  readonly hasConfirmedTotp: boolean;
+}): boolean {
+  if (input.hasConfirmedTotp) return false;
+  return input.roles.some((r) => r.isSystem && MFA_MANDATORY_SYSTEM_ROLE_KEYS.includes(r.key));
+}
+
+/** The permission set of an enrolment-only session: the intersection with {@link ENROLMENT_ONLY_PERMISSIONS} (never wider than before). */
+export function restrictToEnrolment(permissions: ReadonlySet<string>): ReadonlySet<string> {
+  return new Set(ENROLMENT_ONLY_PERMISSIONS.filter((k) => permissions.has(k)));
+}
