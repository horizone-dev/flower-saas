--- /dev/null
+++ b/apps/api/src/modules/access/mfa-enrolment-gate.integration.test.ts
@@ -0,0 +1,406 @@
+import 'reflect-metadata';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { Test } from '@nestjs/testing';
+import { FastifyAdapter, type NestFastifyApplication } from '@nestjs/platform-fastify';
+import { startTestStack, migrateTestDb, type TestStack } from '@flower/testing';
+import { PLATFORM_PERMISSIONS } from '@flower/permissions';
+import { authenticator } from 'otplib';
+import pg from 'pg';
+import { AppModule } from '../../app.module.js';
+import { AllExceptionsFilter } from '../../common/errors/all-exceptions.filter.js';
+import { installRequestContext } from '../../common/context/index.js';
+import { JwtService } from '../../common/auth/jwt.service.js';
+import { SessionStore } from '../../common/auth/session-store.js';
+import type { SessionData } from '../../common/auth/session.types.js';
+import { SessionAccessRefresher } from './session-access.refresher.js';
+import { PolicyService } from './policy.service.js';
+import { toAccessSnapshot } from './policy.types.js';
+
+// F-7c safeguard — a newly invited MANAGER has an enrolment-only session until a TOTP factor is CONFIRMED.
+// Real PostgreSQL + Redis, the real guard pipeline, the real login / invite / enrol / step-up routes.
+const PLAN_V = '00000000-0000-7000-8000-000000190001';
+const PLATFORM_USER = '00000000-0000-7000-8000-000000190002';
+const PW = 'staff-pass-strong-1';
+const ZERO = '00000000-0000-7000-8000-000000000001';
+
+interface Ws {
+  tenantId: string;
+  companyId: string;
+  branchId: string;
+  slug: string;
+}
+interface Staff {
+  email: string;
+  userId: string;
+  token: string;
+  refreshToken: string;
+}
+
+describe('F-7c manager MFA enrolment gate', () => {
+  let stack: TestStack;
+  let app: NestFastifyApplication;
+  let admin: pg.Client;
+  let opToken: string;
+  let A: Ws;
+  let B: Ws;
+  let mgrA: Staff;
+  let mgrB: Staff;
+  let cashA: Staff;
+  const secrets = new Map<string, string>();
+
+  async function platformToken(): Promise<string> {
+    const s: SessionData = {
+      sessionId: 'gate-op',
+      realm: 'platform',
+      familyId: 'f',
+      tenantId: null,
+      userId: null,
+      platformUserId: PLATFORM_USER,
+      accountType: 'PLATFORM',
+      posTerminalId: null,
+      deviceId: null,
+      mfaLevel: 'STEP_UP',
+      stepUpUntil: Date.now() + 600_000,
+      createdAt: Date.now(),
+      expiresAt: Date.now() + 3_600_000,
+      revokedAt: null,
+      revokeReason: null,
+      impersonatorPlatformUserId: null,
+      access: {
+        effectivePermissions: [...PLATFORM_PERMISSIONS],
+        companyScope: 'ALL',
+        branchScope: 'ALL',
+        perBranchOverlay: {},
+        entitledModules: [],
+        planKey: null,
+      },
+    };
+    await app.get(SessionStore).set(s);
+    return app.get(JwtService).sign({ sub: PLATFORM_USER, sid: s.sessionId, aud: 'platform' });
+  }
+
+  async function provision(slug: string): Promise<Ws> {
+    const r = await app.inject({
+      method: 'POST',
+      url: '/v1/platform/tenants',
+      payload: {
+        slug,
+        name: `${slug} FZE`,
+        region: 'AE',
+        companyCountryCode: 'AE',
+        businessTypeKey: 'CUSTOM',
+        planVersionId: PLAN_V,
+        ownerEmail: `owner@${slug}.test`,
+      },
+      headers: { authorization: `Bearer ${opToken}`, 'idempotency-key': `prov-${slug}` },
+    });
+    expect(r.statusCode).toBe(201);
+    const j = r.json();
+    return { tenantId: j.tenantId, companyId: j.companyId, branchId: j.branchId, slug };
+  }
+
+  const login = (w: Ws, email: string) =>
+    app.inject({
+      method: 'POST',
+      url: '/v1/auth/login',
+      payload: { workspaceSlug: w.slug, email, password: PW },
+    });
+
+  /** invite through route A, set the password, log in with the password only */
+  async function onboard(w: Ws, roleKey: 'manager' | 'cashier', name: string): Promise<Staff> {
+    const email = `${name}@${w.slug}.test`;
+    const inv = await app.inject({
+      method: 'POST',
+      url: `/v1/platform/tenants/${w.tenantId}/staff-invites`,
+      payload: { email, roleKey, companyIds: [w.companyId], branchIds: [w.branchId] },
+      headers: { authorization: `Bearer ${opToken}` },
+    });
+    expect(inv.statusCode).toBe(201);
+    const sp = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/set-password',
+      payload: { token: inv.json().setPasswordToken, newPassword: PW },
+    });
+    expect(sp.statusCode).toBeLessThan(300);
+    const l = await login(w, email);
+    expect(l.statusCode).toBe(200);
+    expect(l.json().status).toBe('ok');
+    return {
+      email,
+      userId: inv.json().userId,
+      token: l.json().accessToken,
+      refreshToken: l.json().refreshToken,
+    };
+  }
+
+  const auth = (t: string) => ({ authorization: `Bearer ${t}` });
+  const perms = async (t: string): Promise<string[]> => {
+    const r = await app.inject({ method: 'GET', url: '/v1/me/access', headers: auth(t) });
+    expect(r.statusCode).toBe(200);
+    return (r.json().effectivePermissions ?? r.json().permissions ?? []) as string[];
+  };
+  const post = (t: string, url: string) =>
+    app.inject({
+      method: 'POST',
+      url,
+      payload: {},
+      headers: { ...auth(t), 'idempotency-key': `gate-${Math.random()}` },
+    });
+  const scoped = (w: Ws) => `/v1/companies/${w.companyId}/branches/${w.branchId}`;
+  const money = (w: Ws) => ({
+    payments: `${scoped(w)}/invoices/${ZERO}/payments`,
+    receipt: `${scoped(w)}/customers/${ZERO}/receipts`,
+    advance: `${scoped(w)}/customers/${ZERO}/advances/${ZERO}/applications`,
+    conversion: `${scoped(w)}/customers/${ZERO}/advances/from-payment`,
+    refund: `${scoped(w)}/customers/${ZERO}/advances/${ZERO}/refunds`,
+  });
+  const denied = async (t: string, url: string) => {
+    const r = await post(t, url);
+    return { status: r.statusCode, code: r.json().error?.code as string | undefined };
+  };
+
+  async function enrol(t: string, userId: string): Promise<string> {
+    const en = await app.inject({ method: 'POST', url: '/v1/auth/mfa/enrol', headers: auth(t) });
+    expect(en.statusCode).toBeLessThan(300);
+    secrets.set(userId, en.json().secret);
+    return en.json().secret as string;
+  }
+  const confirm = (t: string, secret: string) =>
+    app.inject({
+      method: 'POST',
+      url: '/v1/auth/mfa/confirm',
+      payload: { code: authenticator.generate(secret) },
+      headers: auth(t),
+    });
+  /** a fresh login that now demands the code, then the code */
+  async function loginWithCode(w: Ws, s: Staff): Promise<string> {
+    const l = await login(w, s.email);
+    expect(l.json().status).toBe('mfa_required');
+    const v = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/mfa/verify',
+      payload: {
+        mfaChallenge: l.json().mfaChallenge,
+        code: authenticator.generate(secrets.get(s.userId)!),
+      },
+    });
+    expect(v.statusCode).toBe(200);
+    return v.json().accessToken as string;
+  }
+
+  beforeAll(async () => {
+    stack = await startTestStack({ services: ['postgres', 'redis'] });
+    migrateTestDb(stack.postgres.url);
+    admin = new pg.Client({ connectionString: stack.postgres.url });
+    await admin.connect();
+    await admin.query(`
+      INSERT INTO plan (id, key, name, "updatedAt") VALUES ('00000000-0000-7000-8000-000000190000', 'starter', 'Starter', now());
+      INSERT INTO plan_version (id, "planId", version, status, "updatedAt") VALUES ('${PLAN_V}', '00000000-0000-7000-8000-000000190000', 1, 'PUBLISHED', now());
+      INSERT INTO limit_default ("planVersionId", "limitKey", value) VALUES ('${PLAN_V}', 'max_branches', 5), ('${PLAN_V}', 'max_users', 20), ('${PLAN_V}', 'max_sessions_per_user', 20);
+      INSERT INTO platform_user (id, email, name, "updatedAt") VALUES ('${PLATFORM_USER}', 'admin@flower.test', 'Platform Admin', now());
+      INSERT INTO currency (code, exponent, symbol, "nameEn", "nameAr") VALUES ('AED', 2, 'AED', 'UAE Dirham', 'AED-ar');
+      INSERT INTO country (code, "nameEn", "nameAr", region, "defaultCurrencyCode", "weekendModel", active, "updatedAt") VALUES ('AE', 'United Arab Emirates', 'UAE-ar', 'gcc', 'AED', 'SAT_SUN', true, now());
+      INSERT INTO business_type_template (key, version, "nameEn", "nameAr", status, "updatedAt") VALUES ('CUSTOM', 1, 'Custom', 'x', 'ACTIVE', now());
+      INSERT INTO business_type_template_capability ("templateKey", "capabilityKey", enabled, "updatedAt") VALUES ('CUSTOM','strategy.stocked',true,now()),('CUSTOM','branch_pricing',true,now()),('CUSTOM','channel.pos',true,now());
+    `);
+    process.env['DATABASE_URL'] = stack.postgres.url;
+    process.env['PLATFORM_DATABASE_URL'] = stack.postgres.url;
+    process.env['REDIS_URL'] = stack.redis.url;
+    process.env['AUTH_JWT_SECRET'] = 'integration-test-jwt-secret-0000000000';
+    const m = await Test.createTestingModule({ imports: [AppModule] }).compile();
+    app = m.createNestApplication<NestFastifyApplication>(new FastifyAdapter());
+    app.setGlobalPrefix('v1', { exclude: ['healthz', 'readyz'] });
+    app.useGlobalFilters(new AllExceptionsFilter());
+    installRequestContext(app.getHttpAdapter().getInstance());
+    await app.init();
+    await app.getHttpAdapter().getInstance().ready();
+    opToken = await platformToken();
+    A = await provision('gate-a');
+    B = await provision('gate-b');
+    mgrA = await onboard(A, 'manager', 'manager');
+    mgrB = await onboard(B, 'manager', 'manager');
+    cashA = await onboard(A, 'cashier', 'cashier');
+  }, 300_000);
+  afterAll(async () => {
+    await admin?.end();
+    await app?.close();
+    await stack?.stop();
+  });
+
+  it('G1 an invited manager who has not enrolled holds ONLY users:view; every financial route is refused 403 (not just step-up ones)', async () => {
+    expect(await perms(mgrA.token)).toEqual(['users:view']);
+    const m = money(A);
+    for (const url of [m.payments, m.receipt, m.advance, m.conversion, m.refund]) {
+      const r = await denied(mgrA.token, url);
+      expect(r.status, url).toBe(403);
+      expect(r.code, url).not.toBe('STEP_UP_REQUIRED'); // refused on the PERMISSION, before step-up is even relevant
+    }
+  });
+
+  it('G2 existing cashier onboarding and permissions are untouched (payments and receipts still reach the handler; advance:apply stays a manager-tier key)', async () => {
+    const p = await perms(cashA.token);
+    expect(p.length).toBeGreaterThan(1);
+    expect(p).toContain('payments:collect');
+    expect(p).toContain('receivables:collect');
+    expect(p).not.toContain('receivables:advance:apply');
+    const m = money(A);
+    expect((await denied(cashA.token, m.payments)).status).not.toBe(403);
+    expect((await denied(cashA.token, m.receipt)).status).not.toBe(403);
+    expect((await denied(cashA.token, m.advance)).status).toBe(403);
+  });
+
+  it('G3 the restricted manager CAN do the one thing needed: enrol; a PENDING factor does not lift the restriction; step-up is impossible without a confirmed factor', async () => {
+    const su0 = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/step-up',
+      payload: { code: '123456' },
+      headers: auth(mgrA.token),
+    });
+    expect(su0.statusCode).toBe(401);
+    const secret = await enrol(mgrA.token, mgrA.userId);
+    // PENDING only: a fresh login is still password-only (no MFA challenge) and still restricted
+    const l = await login(A, mgrA.email);
+    expect(l.json().status).toBe('ok');
+    expect(await perms(l.json().accessToken)).toEqual(['users:view']);
+    expect((await denied(l.json().accessToken, money(A).payments)).status).toBe(403);
+    expect(secret.length).toBeGreaterThan(8);
+  });
+
+  it('G4 token refresh and the post-RBAC-change session refresh can never widen a restricted session', async () => {
+    const rf = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/refresh',
+      payload: { refreshToken: mgrA.refreshToken },
+    });
+    expect(rf.statusCode).toBe(200);
+    expect(await perms(rf.json().accessToken)).toEqual(['users:view']);
+    await app.get(SessionAccessRefresher).refreshUser(A.tenantId, mgrA.userId);
+    expect(await perms(mgrA.token)).toEqual(['users:view']);
+    expect((await denied(mgrA.token, money(A).advance)).status).toBe(403);
+  });
+
+  it('G5 cross-tenant: another workspace manager who HAS enrolled does not lift this one; and the restricted token cannot touch the other tenant', async () => {
+    const secretB = await enrol(mgrB.token, mgrB.userId);
+    expect((await confirm(mgrB.token, secretB)).statusCode).toBeLessThan(300);
+    const fullB = await loginWithCode(B, mgrB);
+    expect((await perms(fullB)).length).toBeGreaterThan(10);
+    expect((await denied(fullB, money(B).payments)).status).not.toBe(403);
+    // A's manager is still restricted, and its token gets nowhere on B's company/branch
+    expect(await perms(mgrA.token)).toEqual(['users:view']);
+    const cross = await denied(mgrA.token, money(B).payments);
+    expect([401, 403, 404]).toContain(cross.status);
+    // B's enrolled manager (full permissions) cannot reach A's company either
+    const cross2 = await denied(fullB, money(A).payments);
+    expect([401, 403, 404]).toContain(cross2.status);
+    // the confirmed factor row belongs to B only
+    const rows = await admin.query(
+      `SELECT "tenantId" FROM mfa_factor WHERE "userId"=$1 AND status='CONFIRMED'`,
+      [mgrB.userId],
+    );
+    expect(rows.rows.map((r) => r.tenantId)).toEqual([B.tenantId]);
+    expect(
+      (
+        await admin.query(`SELECT 1 FROM mfa_factor WHERE "userId"=$1 AND status='CONFIRMED'`, [
+          mgrA.userId,
+        ])
+      ).rowCount,
+    ).toBe(0);
+  });
+
+  it('G6 after the factor is CONFIRMED: the old session stays restricted, a new login demands the code, and the money routes open; refunds still need an explicit step-up', async () => {
+    const secretA = secrets.get(mgrA.userId)!;
+    expect((await confirm(mgrA.token, secretA)).statusCode).toBeLessThan(300);
+    expect(await perms(mgrA.token)).toEqual(['users:view']); // not widened mid-session
+    const full = await loginWithCode(A, mgrA);
+    const p = await perms(full);
+    expect(p).toEqual(expect.arrayContaining(['payments:collect', 'receivables:advance:apply']));
+    const m = money(A);
+    for (const url of [m.payments, m.receipt, m.advance, m.conversion]) {
+      expect((await denied(full, url)).status, url).not.toBe(403);
+    }
+    const refund = await denied(full, m.refund);
+    expect(refund).toEqual({ status: 403, code: 'STEP_UP_REQUIRED' });
+    const su = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/step-up',
+      payload: { code: authenticator.generate(secretA) },
+      headers: auth(full),
+    });
+    expect(su.statusCode).toBeLessThan(300);
+    expect((await denied(full, m.refund)).code).not.toBe('STEP_UP_REQUIRED');
+  });
+
+  it('G7 the gate is derived from the database every time: losing the confirmed factor re-restricts the next resolution', async () => {
+    const full = await loginWithCode(A, mgrA);
+    expect((await perms(full)).length).toBeGreaterThan(10);
+    await admin.query(`DELETE FROM mfa_factor WHERE "userId"=$1`, [mgrA.userId]);
+    await app.get(SessionAccessRefresher).refreshUser(A.tenantId, mgrA.userId);
+    expect(await perms(full)).toEqual(['users:view']);
+    expect((await denied(full, money(A).payments)).status).toBe(403);
+  });
+
+  /** simulate a session minted by a build WITHOUT the gate: rewrite its stored snapshot to the unrestricted admin view */
+  async function widen(s: Staff): Promise<void> {
+    const claims = await app.get(JwtService).verify(s.token, 'tenant');
+    const sess = (await app.get(SessionStore).get(claims.sid))!;
+    sess.access = toAccessSnapshot(
+      await app.get(PolicyService).resolveForUser(s.userId, A.tenantId),
+    );
+    await app.get(SessionStore).set(sess);
+  }
+
+  it('G8 a session minted BEFORE the gate keeps its snapshot (documented window, at most AUTH_SESSION_TTL_SECONDS); a rotation or an RBAC refresh closes it', async () => {
+    const viaRefresher = await onboard(A, 'manager', 'legacy1');
+    await widen(viaRefresher);
+    expect((await perms(viaRefresher.token)).length).toBeGreaterThan(10);
+    expect((await denied(viaRefresher.token, money(A).payments)).status).not.toBe(403);
+    await app.get(SessionAccessRefresher).refreshUser(A.tenantId, viaRefresher.userId);
+    expect(await perms(viaRefresher.token)).toEqual(['users:view']);
+    expect((await denied(viaRefresher.token, money(A).payments)).status).toBe(403);
+
+    const viaRotation = await onboard(A, 'manager', 'legacy2');
+    await widen(viaRotation);
+    expect((await perms(viaRotation.token)).length).toBeGreaterThan(10);
+    const rf = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/refresh',
+      payload: { refreshToken: viaRotation.refreshToken },
+    });
+    expect(rf.statusCode).toBe(200);
+    expect(await perms(rf.json().accessToken)).toEqual(['users:view']);
+    expect((await denied(rf.json().accessToken, money(A).payments)).status).toBe(403);
+  });
+
+  it('G9 DOCUMENTED LIMITATION: the first enrolment wins (trust on first use) — whoever completes it with the password owns the factor, and the legitimate manager cannot replace it', async () => {
+    const victim = await onboard(A, 'manager', 'tofu');
+    const attacker = (await login(A, victim.email)).json().accessToken as string; // knows the password only
+    const secret = await enrol(attacker, 'attacker');
+    expect((await confirm(attacker, secret)).statusCode).toBeLessThan(300);
+    expect((await login(A, victim.email)).json().status).toBe('mfa_required');
+    const again = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/mfa/enrol',
+      headers: auth(victim.token),
+    });
+    expect(again.statusCode).toBe(409);
+    expect(again.json().error?.code).toBe('MFA_ALREADY_ENROLLED');
+  });
+
+  it('G10 DOCUMENTED LIMITATION: once a factor is CONFIRMED there is no self-service way to replace it (M-1), so a lost authenticator needs an operator reset flow that does not exist yet', async () => {
+    const m = await onboard(A, 'manager', 'recover');
+    const secret = await enrol(m.token, m.userId);
+    expect((await confirm(m.token, secret)).statusCode).toBeLessThan(300);
+    const full = await loginWithCode(A, m);
+    for (const t of [full, m.token]) {
+      const r = await app.inject({ method: 'POST', url: '/v1/auth/mfa/enrol', headers: auth(t) });
+      expect(r.statusCode).toBe(409);
+    }
+    const c = await app.inject({
+      method: 'POST',
+      url: '/v1/auth/mfa/confirm',
+      payload: { code: '000000' },
+      headers: auth(full),
+    });
+    expect(c.statusCode).toBe(409);
+  });
+});
diff --git a/apps/api/src/modules/access/mfa-enrolment-gate.test.ts b/apps/api/src/modules/access/mfa-enrolment-gate.test.ts
