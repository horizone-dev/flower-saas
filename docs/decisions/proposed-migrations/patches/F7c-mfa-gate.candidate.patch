+++ b/apps/api/src/modules/access/mfa-enrolment-gate.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it } from 'vitest';
+import {
+  ENROLMENT_ONLY_PERMISSIONS,
+  MFA_MANDATORY_SYSTEM_ROLE_KEYS,
+  mfaEnrolmentRequired,
+  restrictToEnrolment,
+} from './mfa-enrolment-gate.js';
+import { PolicyService } from './policy.service.js';
+import type { AccessRepository, UserAccessRow } from './access.repository.js';
+
+const role = (key: string, isSystem = true) => ({ key, isSystem });
+
+describe('mfa-enrolment-gate (pure)', () => {
+  it('the mandatory list is exactly [manager] and the enrolment-only list exactly [users:view] (changing either is a security decision)', () => {
+    expect([...MFA_MANDATORY_SYSTEM_ROLE_KEYS]).toEqual(['manager']);
+    expect([...ENROLMENT_ONLY_PERMISSIONS]).toEqual(['users:view']);
