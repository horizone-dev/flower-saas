diff --git a/apps/api/src/modules/orders/f6-vat-server.integration.test.ts b/apps/api/src/modules/orders/f6-vat-server.integration.test.ts
new file mode 100644
index 0000000..0f87fc7
--- /dev/null
+++ b/apps/api/src/modules/orders/f6-vat-server.integration.test.ts
@@ -0,0 +1,159 @@
+import 'reflect-metadata';
+import { randomUUID } from 'node:crypto';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { startTestStack, migrateTestDb, type TestStack } from '@flower/testing';
+import { createSaleWorld, type SaleWorld } from '../../verification/load-sale-world.js';
+
+/**
+ * F-6 server amendment (PROPOSED) — through the PUBLIC HTTP routes only, real PostgreSQL: no client is involved, so this is what a direct
+ * API caller can do. A VAT-regime country (AE). The world's variant is classified ZERO_RATED (an explicit 0 bps rate row).
+ * Legacy state is simulated by clearing the category in SQL (the API can no longer create it).
+ */
+describe('F-6 — a direct API caller cannot create a taxable sale with a missing VAT classification', () => {
+  let stack: TestStack;
+  let w: SaleWorld;
+  const br = (): string => w.a.branches[0]!;
+  const q = async <T = Record<string, unknown>>(text: string, p: unknown[] = []): Promise<T[]> =>
+    (await w.pool.query(text, p)).rows as T[];
+  const setCat = (key: string | null): Promise<unknown> =>
+    q(`UPDATE variant SET "taxCategoryKey" = $2, version = version + 1 WHERE id = $1`, [
+      w.variantId,
+      key,
+    ]);
+  const order = (
+    lines: object[] = [
+      { productId: w.productId, variantId: w.variantId, selectedUomCode: 'piece', quantity: '1' },
+    ],
+  ) =>
+    w.req(
+      'POST',
+      `/companies/${w.a.companyId}/branches/${br()}/orders`,
+      w.ownerToken,
+      { lines },
+      { 'idempotency-key': `f6-${randomUUID()}` },
+    );
+  const orderCount = async (): Promise<number> =>
+    Number(
+      (
+        await q<{ n: number }>(`SELECT count(*)::int AS n FROM "order" WHERE "tenantId" = $1`, [
+          w.a.tenantId,
+        ])
+      )[0]!.n,
+    );
+
+  beforeAll(async () => {
+    stack = await startTestStack({ services: ['postgres', 'redis'] });
+    migrateTestDb(stack.postgres.url);
+    w = await createSaleWorld({ pg: stack.postgres.url, redis: stack.redis.url }, 2, {
+      realClock: true,
+    });
+    await q(
+      `INSERT INTO tax_category (key, "nameEn", "nameAr") VALUES ('EXEMPT','Exempt','x'),('STANDARD','Standard','x') ON CONFLICT (key) DO NOTHING`,
+    );
+    await q(
+      `INSERT INTO tax_rate ("countryCode","taxCategoryKey","rateBps","effectiveFrom","effectiveTo")
+       SELECT 'AE', k, b, '2020-01-01', NULL FROM (VALUES ('EXEMPT', 0), ('STANDARD', 500)) AS t(k, b)
+       WHERE NOT EXISTS (SELECT 1 FROM tax_rate r WHERE r."countryCode" = 'AE' AND r."taxCategoryKey" = t.k)`,
+    );
+  }, 300_000);
+
+  afterAll(async () => {
+    await w?.h.close();
+    await w?.pool.end();
+    await stack?.stop();
+  });
+
+  it('the world variant is explicitly ZERO_RATED and still sells with tax 0 (a real 0 bps rate, not a missing one)', async () => {
+    await setCat('ZERO_RATED');
+    const s = await w.sale({ co: w.a, branch: br(), token: w.ownerToken });
+    expect(s.ok, JSON.stringify(s)).toBe(true);
+    const line = (
+      await q(`SELECT "taxCategoryKey", "rateBps" FROM order_line WHERE "orderId" = $1`, [
+        s.orderId,
+      ])
+    )[0];
+    expect(line).toEqual({ taxCategoryKey: 'ZERO_RATED', rateBps: 0 });
+  });
+
+  it('EXEMPT sells with tax 0; STANDARD sells with 5% — both through complete-sale', async () => {
+    for (const [cat, tax] of [
+      ['EXEMPT', 0n],
+      ['STANDARD', 50n],
+    ] as const) {
+      await setCat(cat);
+      const c = await order();
+      expect(c.status, JSON.stringify(c.body)).toBe(201);
+      const o = (c.body as { order: { id: string; version: number } }).order;
+      const total = 1000n + tax;
+      const done = await w.req(
+        'POST',
+        `/companies/${w.a.companyId}/branches/${br()}/orders/${o.id}/complete-sale`,
+        w.ownerToken,
+        { paymentIntent: 'PAY_NOW', tenders: [{ method: 'CASH', amountMinor: total.toString() }] },
+        { 'if-match': String(o.version), 'idempotency-key': `f6s-${randomUUID()}` },
+      );
+      expect(done.status, JSON.stringify(done.body)).toBe(200);
+      const inv = (
+        await q<{ tax: string }>(
+          `SELECT i."taxTotalAmountMinor"::text AS tax FROM invoice i WHERE i."orderId" = $1`,
+          [o.id],
+        )
+      )[0]!;
+      expect(inv.tax).toBe(tax.toString());
+    }
+  });
+
+  it('a variant with NO category is refused at order creation (422), no order is created, and complete-sale is unreachable', async () => {
+    await setCat(null);
+    await q(`UPDATE product SET "taxCategoryKey" = NULL WHERE id = $1`, [w.productId]);
+    const before = await orderCount();
+    const c = await order();
+    expect(c.status).toBe(422);
+    expect((c.body as { error: { code: string } }).error.code).toBe(
+      'ORDER_LINE_TAX_NOT_CONFIGURED',
+    );
+    expect(await orderCount()).toBe(before);
+    const s = await w.sale({ co: w.a, branch: br(), token: w.ownerToken });
+    expect(s).toMatchObject({ ok: false, step: 'create', code: 'ORDER_LINE_TAX_NOT_CONFIGURED' });
+  });
+
+  it('bypass attempts fail too: UPDATE of a draft order to an unclassified line; the product default is inherited', async () => {
+    await setCat('ZERO_RATED');
+    const c = await order();
+    const o = (c.body as { order: { id: string; version: number } }).order;
+    await setCat(null); // legacy variant, product still has no category
+    const upd = await w.h.app.inject({
+      method: 'PATCH',
+      url: `/v1/companies/${w.a.companyId}/branches/${br()}/orders/${o.id}`,
+      headers: { authorization: `Bearer ${w.ownerToken}`, 'if-match': String(o.version) },
+      payload: {
+        lines: [
+          {
+            productId: w.productId,
+            variantId: w.variantId,
+            selectedUomCode: 'piece',
+            quantity: '2',
+          },
+        ],
+      },
+    });
+    expect(upd.statusCode, upd.payload).toBe(422);
+    expect((upd.json() as { error: { code: string } }).error.code).toBe(
+      'ORDER_LINE_TAX_NOT_CONFIGURED',
+    );
+    // a product-level category is inherited (variant NULL) and unblocks the sale
+    await q(`UPDATE product SET "taxCategoryKey" = 'STANDARD' WHERE id = $1`, [w.productId]);
+    const ok = await order();
+    expect(ok.status, JSON.stringify(ok.body)).toBe(201);
+  });
+
+  it('INVARIANT: no order line anywhere in the database was recorded with a missing tax category', async () => {
+    const n = (
+      await q<{ n: number }>(
+        `SELECT count(*)::int AS n FROM order_line WHERE "tenantId" = $1 AND "taxCategoryKey" IS NULL`,
+        [w.a.tenantId],
+      )
+    )[0]!.n;
+    expect(n).toBe(0);
+  });
+});
