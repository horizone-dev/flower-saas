+
+  const sessionProof = (dev: Dev): string =>
+    signProof(dev.privateKey, defaultParts(dev.id, 'session', nonces.issue(dev.id, 'session'), {}));
+
+  /** a REAL device-bound login; the stored snapshot then carries the cashier role's real grants plus the cash keys (an approved enablement) */
+  async function boundToken(user: { email: string }, dev: Dev): Promise<string> {
+    const login = await w.h.app.inject({
+      method: 'POST',
+      url: '/v1/auth/login',
+      payload: { workspaceSlug: slugA, email: user.email, password: PASSWORD },
+      headers: { 'x-device-proof': sessionProof(dev) },
+    });
+    expect(login.statusCode, login.body).toBe(200);
+    const token = login.json().accessToken as string;
+    const sid = JSON.parse(Buffer.from(token.split('.')[1]!, 'base64url').toString('utf8'))
+      .sid as string;
+    const blob = (await w.h.store.get(sid))!;
+    blob.access = {
+      ...blob.access!,
+      effectivePermissions: [
+        ...new Set([
+          ...blob.access!.effectivePermissions,
+          ...rolePerms('owner').filter((k) => !k.startsWith('platform:')),
+          'cash_register:open',
+          'cash_register:view',
+          'cash_register:close',
+        ]),
+      ],
+    };
+    await w.h.store.set(blob);
+    return token;
+  }
+
+  /** a terminal + cashier + bound session + an OPEN register session (float 200.00) — a shift */
+  /** every journal row of the tenant, fingerprinted: a recorder call must leave it bit-for-bit identical */
+  const journalFingerprint = async (): Promise<{ h: string; entries: number; lines: number }> => {
+    const r = (
+      await rows(
+        `SELECT md5(coalesce(string_agg(t, '|' ORDER BY t), '')) AS h,
+                (SELECT count(*) FROM journal_entry WHERE "tenantId" = $1)::int AS entries,
+                (SELECT count(*) FROM journal_line WHERE "tenantId" = $1)::int AS lines
+           FROM (
+             SELECT je.id::text || ':' || je."sourceKind" || ':' || je."sourceId"::text || ':' || je."postingFingerprint" AS t
+               FROM journal_entry je WHERE je."tenantId" = $1
+             UNION ALL
+             SELECT jl.id::text || ':' || jl."debitMinor"::text || ':' || jl."creditMinor"::text || ':' || jl."accountId"::text
+               FROM journal_line jl WHERE jl."tenantId" = $1
+           ) x`,
+        [w.a.tenantId],
+      )
+    )[0]!;
+    return { h: r['h'] as string, entries: r['entries'] as number, lines: r['lines'] as number };
+  };
