+
+  async function activate(
+    code: string,
+    terminalId: string,
+    branchId: string,
+    tenantId: string,
+  ): Promise<Dev> {
+    const k = makeDeviceKey();
+    const proof = signRaw(
+      k.privateKey,
+      canonicalize({ alg: PROOF_ALG, kid: k.thumbprint, typ: PROOF_TYP }),
+      canonicalize({
+        aud: PROOF_AUD,
+        cdh: codeDigestB64(code.replace(/-/g, '').toUpperCase()),
+        purpose: 'activate',
+        v: PROOF_VERSION,
+      }),
+    );
+    // test-only: reset the activation abuse counters (the production limiter is untouched; 10 per minute is below this suite's need)
+    const rc = new Redis(stack.redis.url);
+    const stale = await rc.keys('*devact:src:*');
+    if (stale.length) await rc.del(...stale);
+    rc.disconnect();
+    const act = await w.h.app.inject({
+      method: 'POST',
+      url: '/v1/devices/activate',
+      payload: {
+        code,
+        publicKey: k.spki.toString('base64url'),
+        proof,
+        keyCustody: 'WEBCRYPTO_NONEXTRACTABLE',
+        platform: 'WEB',
+      },
+    });
+    expect(act.statusCode, act.body).toBe(201);
+    return {
+      id: act.json().deviceId as string,
+      privateKey: k.privateKey,
+      terminalId,
+      branchId,
+      tenantId,
+    };
+  }
+
+  /** a terminal with an ACTIVE enrolled device and (by default) a provisioned cash register */
+  async function terminal(
