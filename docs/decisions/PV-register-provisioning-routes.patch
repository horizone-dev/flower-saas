+    `/companies/${companyId}/branches/${t.branchId}/pos-terminals/${t.terminalId}/register${tail}`;
+  const post = (
+    token: string,
+    t: { terminalId: string; branchId: string },
+    tail = '',
+    o: { key?: string | null; companyId?: string } = {},
+  ) =>
+    w.req(
+      'POST',
+      urlOf(t, tail, o.companyId),
+      token,
+      {},
+      o.key === null ? {} : { 'idempotency-key': o.key ?? randomUUID() },
+    );
+  const registerRows = (terminalId: string) =>
+    rows(`SELECT * FROM cash_register WHERE "posTerminalId" = $1`, [terminalId]);
+  const auditActions = (registerId: string) =>
