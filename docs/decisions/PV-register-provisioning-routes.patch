+  async function mkUser(branchId: string): Promise<{ userId: string; email: string }> {
+    const userId = randomUUID();
+    const email = `c-${randomBytes(4).toString('hex')}@e5.test`;
+    await rows(
+      `INSERT INTO "user" (id, "tenantId", "accountType", email, status, "updatedAt") VALUES ($1,$2,'USER',$3,'ACTIVE',now())`,
+      [userId, w.a.tenantId, email],
