+    );
+    if (o.register !== false) {
+      await rows(
+        `INSERT INTO cash_register ("tenantId","companyId","branchId","posTerminalId","active","updatedAt") VALUES ($1,$2,$3,$4,true,now())`,
+        [w.a.tenantId, w.a.companyId, branchId, terminalId],
+      );
