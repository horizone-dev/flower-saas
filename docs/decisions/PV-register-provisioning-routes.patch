+import { Injectable } from '@nestjs/common';
+import { requireTenantContext, type RequestContext } from '../../common/context/index.js';
+import { DomainError, ForbiddenError } from '../../common/errors/domain-error.js';
+import { ProvisioningGate } from './provisioning-gate.js';
+import {
+  RegisterProvisioningRepository,
+  type ProvisionOutcome,
+  type RegisterView,
+  type ToggleOutcome,
+} from './register-provisioning.repository.js';
+
+/**
+ * Register provisioning (Phase 4) — the Owner-only operations behind the provisioning routes. Same Owner rule as registered-device
+ * administration (ADR-0022 D11): the permission key is `devices:manage` (Owner-only by migration 52, step-up gated by code), AND the
+ * account must be the OWNER with an unrestricted company / branch scope — a custom role that is later granted the key still cannot use it.
+ * Company and branch come from the scoped PATH (verified against the session by the pipeline) and are then checked against the TERMINAL's
+ * own; the tenant and actor come from the verified request context only.
+ */
+
+export interface RegisterResponse {
+  id: string;
+  posTerminalId: string;
+  companyId: string;
+  branchId: string;
+  active: boolean;
+}
+
+const NOT_FOUND = new Set(['TERMINAL_NOT_FOUND', 'REGISTER_NOT_FOUND']);
+
+@Injectable()
+export class RegisterProvisioningService {
+  constructor(
+    private readonly repo: RegisterProvisioningRepository,
+    private readonly gate: ProvisioningGate,
+  ) {}
+
+  async provision(p: {
+    companyId: string;
+    branchId: string;
+    terminalId: string;
+  }): Promise<RegisterResponse> {
+    this.gate.assertOpen();
+    this.requireOwner(requireTenantContext());
+    const out = await this.repo.provision({
+      posTerminalId: p.terminalId,
+      companyId: p.companyId,
+      branchId: p.branchId,
+    });
+    return this.respond(out);
+  }
+
+  async deactivate(p: {
+    companyId: string;
+    branchId: string;
+    terminalId: string;
+  }): Promise<RegisterResponse> {
+    this.gate.assertOpen();
+    this.requireOwner(requireTenantContext());
+    return this.respond(
+      await this.repo.deactivate({
+        posTerminalId: p.terminalId,
+        expected: { companyId: p.companyId, branchId: p.branchId },
+      }),
+    );
+  }
+
+  async reactivate(p: {
+    companyId: string;
+    branchId: string;
+    terminalId: string;
+  }): Promise<RegisterResponse> {
+    this.gate.assertOpen();
+    this.requireOwner(requireTenantContext());
+    return this.respond(
+      await this.repo.reactivate({
+        posTerminalId: p.terminalId,
+        expected: { companyId: p.companyId, branchId: p.branchId },
+      }),
+    );
+  }
+
+  private requireOwner(ctx: RequestContext): void {
+    const ok =
+      ctx.accountType === 'OWNER' &&
+      ctx.companyScope === 'ALL' &&
+      ctx.branchScope === 'ALL' &&
+      ctx.tenantId !== null &&
+      ctx.userId !== null;
+    if (!ok) {
+      throw new ForbiddenError(
+        'only the account owner may provision cash registers',
+        'OWNER_REQUIRED',
+      );
+    }
+  }
+
+  private respond(out: ProvisionOutcome | ToggleOutcome): RegisterResponse {
+    if (out.kind === 'REFUSED') {
+      if (NOT_FOUND.has(out.reason)) {
+        throw new DomainError(out.reason, 'the terminal or its register was not found', 404);
+      }
+      throw new DomainError(out.reason, `the register change was refused: ${out.reason}`, 409);
+    }
+    const r: RegisterView = out.register;
+    return {
+      id: r.id,
+      posTerminalId: r.posTerminalId,
+      companyId: r.companyId,
+      branchId: r.branchId,
+      active: r.active,
+    };
+  }
+}
