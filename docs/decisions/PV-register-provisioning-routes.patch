+import { describe, expect, it } from 'vitest';
+import { NotFoundError } from '../../common/errors/domain-error.js';
+import type { AppConfig } from '../../config/env.js';
+import {
+  ProvisioningGate,
+  RegisterProvisioningGateGuard,
+  parseProvisioningGate,
+} from './provisioning-gate.js';
+
+const gateOf = (raw: unknown): ProvisioningGate =>
+  new ProvisioningGate({ REGISTER_PROVISIONING_ENABLED: raw } as unknown as AppConfig);
+
+describe('provisioning gate — fail closed', () => {
+  it('only the exact lower-case string "true" opens it', () => {
+    expect(parseProvisioningGate('true')).toBe(true);
+    for (const raw of [
+      undefined,
+      null,
+      '',
+      'false',
+      'TRUE',
+      'True',
+      '1',
+      'yes',
+      'on',
+      ' true',
+      'true ',
+      'true\n',
+      'enabled',
+      true,
+      1,
+      {},
+      [],
+      ['true'],
+    ]) {
+      expect(parseProvisioningGate(raw), String(raw)).toBe(false);
+    }
+  });
+
+  it('a closed gate answers 404 ROUTE_DISABLED from the guard AND from assertOpen; an open gate lets the request through', () => {
+    for (const raw of [undefined, 'false', 'TRUE', 'garbage']) {
+      const g = gateOf(raw);
+      expect(g.enabled).toBe(false);
+      expect(() => new RegisterProvisioningGateGuard(g).canActivate()).toThrow(NotFoundError);
+      try {
+        g.assertOpen();
+      } catch (e) {
+        expect(e).toMatchObject({ code: 'ROUTE_DISABLED', status: 404 });
+      }
+    }
+    const open = gateOf('true');
+    expect(new RegisterProvisioningGateGuard(open).canActivate()).toBe(true);
+    expect(() => open.assertOpen()).not.toThrow();
+  });
+});
