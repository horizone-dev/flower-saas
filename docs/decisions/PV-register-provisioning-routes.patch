+import { Body, Controller, HttpCode, Param, Post, UseGuards } from '@nestjs/common';
+import { ScopedParam } from '../../common/auth/pipeline.decorators.js';
+import { RequirePermission } from '../../common/auth/require-permission.decorator.js';
+import { Idempotent } from '../../common/idempotency/idempotent.decorator.js';
+import { requireUuidParam } from '../../common/validation/uuid-param.js';
+import { ZodBody } from '../../common/validation/zod-body.js';
+import { emptyBodySchema } from '../devices/devices.dto.js';
+import { RegisterProvisioningGateGuard } from './provisioning-gate.js';
+import {
+  RegisterProvisioningService,
+  type RegisterResponse,
+} from './register-provisioning.service.js';
+
+/**
+ * Register provisioning routes (Phase 4) — Owner-only, step-up gated, NOT device-bound: they are `devices:manage` routes (not
+ * `cash_register:*`), so the registered-device guard does not demand a terminal device from the Owner's web session. The company and
+ * branch are scoped PATH parameters (the pipeline verifies them against the session's scope); the terminal id names the object being
+ * provisioned. No body field carries a scope, an actor or a sign. Each POST requires an `Idempotency-Key`.
+ */
+@UseGuards(RegisterProvisioningGateGuard)
+@Controller('companies/:companyId/branches/:branchId/pos-terminals/:terminalId/register')
+export class RegisterProvisioningController {
+  constructor(private readonly provisioning: RegisterProvisioningService) {}
+
+  /** create the single register of a terminal (an ACTIVE terminal with an ACTIVE device); a second call is 409 ALREADY_PROVISIONED */
+  @Post()
+  @HttpCode(201)
+  @RequirePermission('devices:manage')
+  @ScopedParam({ company: 'companyId', branch: 'branchId' })
+  @Idempotent({ scope: 'cash_register.register.provision' })
+  provision(
+    @Param('companyId') companyId: string,
+    @Param('branchId') branchId: string,
+    @Param('terminalId') terminalId: string,
+    @Body(new ZodBody(emptyBodySchema)) _dto: object,
+  ): Promise<RegisterResponse> {
+    return this.provisioning.provision({
+      companyId: requireUuidParam(companyId),
+      branchId: requireUuidParam(branchId),
+      terminalId: requireUuidParam(terminalId),
+    });
+  }
+
+  /** switch the register off; refused (409) while a session is OPEN or COUNTING */
+  @Post('deactivate')
+  @HttpCode(200)
+  @RequirePermission('devices:manage')
+  @ScopedParam({ company: 'companyId', branch: 'branchId' })
+  @Idempotent({ scope: 'cash_register.register.deactivate' })
+  deactivate(
+    @Param('companyId') companyId: string,
+    @Param('branchId') branchId: string,
+    @Param('terminalId') terminalId: string,
+    @Body(new ZodBody(emptyBodySchema)) _dto: object,
+  ): Promise<RegisterResponse> {
+    return this.provisioning.deactivate({
+      companyId: requireUuidParam(companyId),
+      branchId: requireUuidParam(branchId),
+      terminalId: requireUuidParam(terminalId),
+    });
+  }
+
+  /** switch the register back on (an ACTIVE terminal with an ACTIVE device) */
+  @Post('reactivate')
+  @HttpCode(200)
+  @RequirePermission('devices:manage')
+  @ScopedParam({ company: 'companyId', branch: 'branchId' })
+  @Idempotent({ scope: 'cash_register.register.reactivate' })
+  reactivate(
+    @Param('companyId') companyId: string,
+    @Param('branchId') branchId: string,
+    @Param('terminalId') terminalId: string,
+    @Body(new ZodBody(emptyBodySchema)) _dto: object,
+  ): Promise<RegisterResponse> {
+    return this.provisioning.reactivate({
+      companyId: requireUuidParam(companyId),
+      branchId: requireUuidParam(branchId),
+      terminalId: requireUuidParam(terminalId),
+    });
+  }
+}
