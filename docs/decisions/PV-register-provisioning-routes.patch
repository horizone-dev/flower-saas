+    );
+    await rows(
+      `INSERT INTO data_scope_assignment ("tenantId","userId","companyScopeAll","companyIds","branchScopeAll","branchIds","updatedAt")
+       VALUES ($1,$2,false,$3,false,$4,now())`,
+      [w.a.tenantId, userId, [w.a.companyId], [branchId]],
+    );
+    await rows(
+      `INSERT INTO credential ("tenantId","userId",kind,hash,"updatedAt") VALUES ($1,$2,'PASSWORD',$3,now())`,
+      [w.a.tenantId, userId, pwHash],
