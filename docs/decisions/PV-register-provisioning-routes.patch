+  // ── harness ───────────────────────────────────────────────────────────────
+  async function rows(sql: string, params: unknown[] = []): Promise<Record<string, unknown>[]> {
+    return (await w.pool.query(sql, params)).rows as Record<string, unknown>[];
+  }
+  const num = async (sql: string, params: unknown[] = []): Promise<number> =>
+    Number((await rows(sql, params))[0]!['n']);
+  const errCode = (r: { body: unknown }): string | undefined =>
+    (r.body as { error?: { code?: string } })?.error?.code;
