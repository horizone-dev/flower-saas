+import { CanActivate, Inject, Injectable } from '@nestjs/common';
+import { NotFoundError } from '../../common/errors/domain-error.js';
+import { APP_CONFIG, type AppConfig } from '../../config/env.js';
+
+/**
+ * Register provisioning FEATURE GATE — FAIL CLOSED. The three Owner-only provisioning routes are reachable only while the deployment sets
+ * `REGISTER_PROVISIONING_ENABLED` to EXACTLY the lower-case string `true`. Unset, empty, `false`, `TRUE`, `1`, `yes`, ` true`, a typo, any
+ * other type — all mean DISABLED. There is no default that enables it and nothing in the application code turns it on.
+ *
+ * Two independent layers (neither trusts the other): a controller guard that answers `404 ROUTE_DISABLED` before the handler runs, and the
+ * service, which refuses every operation itself — so a future second caller of the service cannot bypass the gate.
+ */
+
+/** the ONLY way the flag becomes true: the exact string `true` */
+export function parseProvisioningGate(raw: unknown): boolean {
+  return raw === 'true';
+}
+
+@Injectable()
+export class ProvisioningGate {
+  /** read once from the validated deployment configuration; tests flip it on the singleton */
+  enabled: boolean;
+
+  constructor(@Inject(APP_CONFIG) config: AppConfig) {
+    this.enabled = parseProvisioningGate(config.REGISTER_PROVISIONING_ENABLED);
+  }
+
+  /** throws 404 ROUTE_DISABLED when the gate is closed — the same answer for every terminal, existing or not (no probing) */
+  assertOpen(): void {
+    if (!this.enabled) throw new NotFoundError('route', 'ROUTE_DISABLED');
+  }
+}
+
+@Injectable()
+export class RegisterProvisioningGateGuard implements CanActivate {
+  constructor(private readonly gate: ProvisioningGate) {}
+
+  canActivate(): boolean {
+    this.gate.assertOpen();
+    return true;
+  }
+}
