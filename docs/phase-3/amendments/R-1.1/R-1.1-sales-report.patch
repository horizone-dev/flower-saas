+// ═══════════════════════════ R-1.1 — the fifth source kind: anonymous credit notes ═══════════════════════════
+describe('R-1.1 — anonymous credit notes: shown separately, reconciled to their own journals, never silently absent', () => {
+  const ANON = 'anonymous_credit_note';
+  /** the base scope plus ONE anonymous credit note (total 10 500, tax 500 → net 10 000) and its journal lines */
+  const withAnon = () => {
+    const s = scope();
+    return {
+      aggregate: { ...s.aggregate, anonymousCreditNoteCount: 1, anonymousCreditNoteTotal: 10_500n, anonymousCreditNoteTax: 500n },
+      statuses: s.statuses,
+      ledger: [
+        ...s.ledger,
+        gl(ANON, REV, 10_000n, 0n),
+        gl(ANON, TAX, 500n, 0n),
+        gl(ANON, 'ASSET.PAYMENT_CLEARING', 0n, 10_500n), // the in-flight leg: not part of a Sales control
+      ],
+    };
+  };
+  const build = (x: ReturnType<typeof withAnon>) => buildSalesFinancialBlocks(x.aggregate, x.statuses, x.ledger);
+
+  it('a separate block (count, net ex-tax = total − tax, tax, total) — never merged into the customer-linked credit notes', () => {
+    const b = build(withAnon());
+    expect(b.anonymousCreditNotes).toEqual({
+      anonymousCreditNoteCount: 1,
+      anonymousCreditNoteNetExTaxMinor: '10000',
+      anonymousCreditNoteTaxMinor: '500',
+      anonymousCreditNoteTotalMinor: '10500',
+    });
+    expect(b.creditNotes.creditNoteTotalMinor).toBe('5250'); // unchanged: customer-linked only
+  });
+
+  it('the explicit net after ALL credits = invoices − credit notes − anonymous credit notes; the legacy net keeps its historical meaning', () => {
+    const b = build(withAnon());
+    expect(b.netSalesAfterAllCredits).toEqual({
+      netSalesAfterAllCreditsExTaxMinor: '15000', // 30 000 − 5 000 − 10 000
+      netSalesAfterAllCreditsTaxMinor: '750', // 1 500 − 250 − 500
+      netSalesAfterAllCreditsTotalMinor: '15750', // 31 500 − 5 250 − 10 500
+    });
+    expect(b.netSalesAfterCreditNotes).toEqual({
+      netSalesAfterCreditNotesExTaxMinor: '25000',
+      netSalesAfterCreditNotesTaxMinor: '1250',
+      netSalesAfterCreditNotesTotalMinor: '26250',
+    });
+  });
+
+  it('no anonymous credit note: zeros, and EVERY legacy figure is byte-identical to the report without the amendment', () => {
+    const s = scope();
+    const b = buildSalesFinancialBlocks(s.aggregate, s.statuses, s.ledger);
+    expect(b.anonymousCreditNotes.anonymousCreditNoteTotalMinor).toBe('0');
+    expect(b.netSalesAfterAllCredits.netSalesAfterAllCreditsExTaxMinor).toBe(b.netSalesAfterCreditNotes.netSalesAfterCreditNotesExTaxMinor);
+    expect(b.reconciliation.anonymousCreditNotes.revenueReversal).toEqual({ sourceMinor: '0', glMinor: '0', differenceMinor: '0', reconciled: true });
+    expect(b.invoices.salesNetExTaxMinor).toBe('30000');
+  });
+
+  it('each anonymous control reconciles its OWN kind, account and side — a difference of one minor unit fails the report CLOSED', () => {
+    const mismatch = (f: (x: ReturnType<typeof withAnon>) => ReturnType<typeof withAnon>) =>
+      failure(() => build(f(withAnon()))).code;
+    const lines = (x: ReturnType<typeof withAnon>, key: string, kind: string) => x.ledger.findIndex((l) => l.accountKey === key && l.sourceKind === kind);
+    // the revenue reversal
+    expect(mismatch((x) => { x.ledger[lines(x, REV, ANON)] = gl(ANON, REV, 9_999n, 0n); return x; })).toBe('REPORT_SALES_GL_MISMATCH');
+    // the output-tax reversal
+    expect(mismatch((x) => { x.ledger[lines(x, TAX, ANON)] = gl(ANON, TAX, 499n, 0n); return x; })).toBe('REPORT_SALES_GL_MISMATCH');
+    // the reversal posted on the wrong side
+    expect(mismatch((x) => { x.ledger[lines(x, REV, ANON)] = gl(ANON, REV, 0n, 10_000n); return x; })).toBe('REPORT_SALES_GL_MISMATCH');
+    // the same amounts under ANOTHER kind (credit_note) do not satisfy the anonymous control
+    expect(mismatch((x) => { x.ledger[lines(x, REV, ANON)] = gl('credit_note', REV, 10_000n, 0n); return x; })).toBe('REPORT_SALES_GL_MISMATCH');
+  });
+
+  it('A FULLY REVERSED ANONYMOUS SALE cannot be reconciled WITHOUT its credit adjustment: the sale and its reversal journals are in the ledger; if the source side lacks the credit note the report is refused', () => {
+    // one anonymous sale (10 500, tax 500) and its FULL reversal
+    const sale = agg({ invoiceCount: 1, invoicedSubtotal: 10_000n, outputTax: 500n, invoicedTotal: 10_500n });
+    const statuses = [st('PAID', 1, 10_500n)];
+    const ledger = [
+      gl('walk_in_sale', REV, 0n, 10_000n), gl('walk_in_sale', TAX, 0n, 500n),
+      gl(ANON, REV, 10_000n, 0n), gl(ANON, TAX, 500n, 0n),
+    ];
+    // WITH the adjustment: reconciled, and the net after all credits is exactly zero (= the ledger)
+    const ok = buildSalesFinancialBlocks({ ...sale, anonymousCreditNoteCount: 1, anonymousCreditNoteTotal: 10_500n, anonymousCreditNoteTax: 500n }, statuses, ledger);
+    expect(ok.reconciliation.reconciled).toBe(true);
+    expect(ok.netSalesAfterAllCredits).toEqual({
+      netSalesAfterAllCreditsExTaxMinor: '0', netSalesAfterAllCreditsTaxMinor: '0', netSalesAfterAllCreditsTotalMinor: '0',
+    });
+    // WITHOUT it (the credit note missing from the source side while its journal is in the ledger): no report at all
+    expect(failure(() => buildSalesFinancialBlocks(sale, statuses, ledger)).code).toBe('REPORT_SALES_GL_MISMATCH');
+  });
+
+  it('the company aggregate adds the anonymous fields exactly', () => {
+    const a = agg({ branchId: 'x', anonymousCreditNoteCount: 1, anonymousCreditNoteTotal: 10_500n, anonymousCreditNoteTax: 500n });
+    const b = agg({ branchId: 'y', anonymousCreditNoteCount: 2, anonymousCreditNoteTotal: 2_100n, anonymousCreditNoteTax: 100n });
+    expect(sumAggregates('COMPANY', [a, b])).toMatchObject({ anonymousCreditNoteCount: 3, anonymousCreditNoteTotal: 12_600n, anonymousCreditNoteTax: 600n });
+  });
+});
