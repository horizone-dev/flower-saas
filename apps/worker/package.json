{
  "name": "@flower/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ processor host. Boots a Nest application context over @flower/backend — never duplicates business logic (CLAUDE.md rule 1 / FC-3). Separate process from apps/api (OD-P2-8).",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@flower/backend": "workspace:*",
    "@flower/db": "workspace:*",
    "@flower/service-runtime": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@flower/testing": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.1",
    "pg": "8.23.0",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
