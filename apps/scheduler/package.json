{
  "name": "@flower/scheduler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repeatable / cron job registrar (singleton). Enqueues jobs onto BullMQ for the worker to run — holds no business logic (CLAUDE.md rule 1). Phase 0: boot + Redis + health + a heartbeat repeatable.",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@flower/service-runtime": "workspace:*",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
