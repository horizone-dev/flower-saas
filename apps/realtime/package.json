{
  "name": "@flower/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebSocket / SSE gateway. Distinct runtime role, CO-DEPLOYABLE with apps/api in early phases (ADR-0009). Authorizes branch topics and forwards outbox events from Redis Streams — never holds business logic. Phase 0: boot + Redis + WS connect/ack/close, no topics.",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rimraf dist node_modules .turbo"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.0",
    "@flower/service-runtime": "workspace:*",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
