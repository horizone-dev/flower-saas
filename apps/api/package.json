    "@nestjs/platform-fastify": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@flower/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.3",
    "rimraf": "6.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
