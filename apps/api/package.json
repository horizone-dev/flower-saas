{
  "name": "@flower/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST /v1 API — NestJS + Fastify. The only place authoritative business logic lives (CLAUDE.md rule 1).",
  "license": "UNLICENSED",
  "main": "./dist/main.js",
  "scripts": {
